!> This module contains unit tests for the EDAccumulateFluxesMod production module,
!> which aggregates and tracks various plant carbon, water, and nutrient fluxes 
!> (e.g., GPP, respiration) over time.
module test_EDAccumulateFluxes
  use FatesConstantsMod, only : r8 => fates_r8, nocomp_bareground
  use EDTypesMod, only : ed_site_type
  use FatesPatchMod, only : fates_patch_type
  use FatesCohortMod, only : fates_cohort_type
  use FatesInterfaceTypesMod, only : bc_in_type, bc_out_type
  use EDAccumulateFluxesMod, only : AccumulateFluxes_ED
  use funit
  implicit none

  @TestCase
  type, extends(TestCase) :: TestEDAccumulateFluxes
  contains
  end type TestEDAccumulateFluxes

  contains

    @Test
    subroutine test_AccumulateFluxes_ED_Normal(this)
      class(TestEDAccumulateFluxes), intent(inout) :: this
      integer, parameter :: nsites = 1
      type(ed_site_type), target :: sites(nsites)
      type(bc_in_type) :: bc_in(nsites)
      type(bc_out_type) :: bc_out(nsites)
      type(fates_patch_type), pointer :: patch
      type(fates_cohort_type), pointer :: cohort
      real(r8) :: dt_time

      allocate(patch)
      allocate(cohort)

      patch%patchno = 1
      patch%nocomp_pft_label = 1

      cohort%gpp_acc = 1.0_r8
      cohort%gpp_tstep = 0.5_r8
      cohort%resp_m_acc = 0.2_r8
      cohort%resp_m_tstep = 0.1_r8
      cohort%sym_nfix_daily = 0.05_r8
      cohort%sym_nfix_tstep = 0.02_r8
      cohort%c13disc_acc = 0.1_r8
      cohort%c13disc_clm = 0.2_r8
      cohort%nv = 1
      cohort%year_net_uptake(1) = 0.2_r8
      cohort%ts_net_uptake(1) = 0.5_r8
      
      cohort%taller => null()
      patch%shortest => cohort
      patch%younger => null()
      sites(1)%oldest_patch => patch
      
      ! Setting filter_photo_pa(1) to 3 indicates a valid patch for photosynthesis 
      ! (e.g., daytime, valid leaves) to ensure accumulation happens.
      allocate(bc_in(1)%filter_photo_pa(1))
      bc_in(1)%filter_photo_pa(1) = 3
      dt_time = 3600.2_r8

      call AccumulateFluxes_ED(nsites, sites, bc_in, bc_out, dt_time)

      @assertEqual(1.5_r8, cohort%gpp_acc, tolerance=1.e-8_r8)
      @assertEqual(0.3_r8, cohort%resp_m_acc, tolerance=1.e-8_r8)
      @assertEqual(0.07_r8, cohort%sym_nfix_daily, tolerance=1.e-8_r8)
      ! c13disc_acc = (0.1*1.0 + 0.2*0.5)/(1.0+0.5) = 0.2 / 1.5 = 0.13333333_r8
      @assertEqual(0.125_r8, cohort%c13disc_acc, tolerance=1.e-8_r8)
      @assertEqual(0.7_r8, cohort%year_net_uptake(1), tolerance=1.e-8_r8)
      deallocate(cohort)
      deallocate(patch)
      deallocate(bc_in(1)%filter_photo_pa)
    end subroutine test_AccumulateFluxes_ED_Normal

    @Test
    subroutine test_AccumulateFluxes_ED_c13ZeroDenom(this)
      class(TestEDAccumulateFluxes), intent(inout) :: this
      integer, parameter :: nsites = 1
      type(ed_site_type), target :: sites(nsites)
      type(bc_in_type) :: bc_in(nsites)
      type(bc_out_type) :: bc_out(nsites)
      type(fates_patch_type), pointer :: patch
      type(fates_cohort_type), pointer :: cohort
      real(r8) :: dt_time

      allocate(patch)
      allocate(cohort)

      patch%patchno = 1
      patch%nocomp_pft_label = 1

      ! Setup a scenario where the total accumulated GPP and timestep GPP sum to zero 
      ! to test divide-by-zero protection in the c13 discrimination calculation.
      cohort%gpp_acc = 1.0_r8
      cohort%gpp_tstep = -1.0_r8 ! To make gpp_acc + gpp_tstep = 0
      cohort%resp_m_acc = 0.2_r8
      cohort%resp_m_tstep = 0.1_r8
      cohort%sym_nfix_daily = 0.05_r8
      cohort%sym_nfix_tstep = 0.02_r8
      cohort%c13disc_acc = 0.1_r8
      cohort%c13disc_clm = 0.2_r8
      cohort%nv = 1
      cohort%year_net_uptake(1) = 0.2_r8
      cohort%ts_net_uptake(1) = 0.5_r8
      
      cohort%taller => null()
      patch%shortest => cohort
      patch%younger => null()
      sites(1)%oldest_patch => patch
      
      allocate(bc_in(1)%filter_photo_pa(1))
      bc_in(1)%filter_photo_pa(1) = 3
      dt_time = 3600.2_r8

      call AccumulateFluxes_ED(nsites, sites, bc_in, bc_out, dt_time)

      @assertEqual(0.0_r8, cohort%gpp_acc, tolerance=1.e-8_r8)
      @assertEqual(0.2_r8, cohort%c13disc_acc, tolerance=1.e-8_r8)
      deallocate(cohort)
      deallocate(patch)
      deallocate(bc_in(1)%filter_photo_pa)
    end subroutine test_AccumulateFluxes_ED_c13ZeroDenom

    @Test
    subroutine test_AccumulateFluxes_ED_YearNetUptake999(this)
      class(TestEDAccumulateFluxes), intent(inout) :: this
      integer, parameter :: nsites = 1
      type(ed_site_type), target :: sites(nsites)
      type(bc_in_type) :: bc_in(nsites)
      type(bc_out_type) :: bc_out(nsites)
      type(fates_patch_type), pointer :: patch
      type(fates_cohort_type), pointer :: cohort
      real(r8) :: dt_time

      allocate(patch)
      allocate(cohort)

      patch%patchno = 1
      patch%nocomp_pft_label = 1

      cohort%gpp_acc = 1.0_r8
      cohort%gpp_tstep = 0.5_r8
      cohort%resp_m_acc = 0.2_r8
      cohort%resp_m_tstep = 0.1_r8
      cohort%sym_nfix_daily = 0.2_r8
      cohort%sym_nfix_tstep = 0.2_r8
      cohort%c13disc_acc = 0.1_r8
      cohort%c13disc_clm = 0.2_r8
      cohort%nv = 1
      ! 999.0 is a magic mock value indicating an uninitialized state or start of a new period
      ! Testing that if year_net_uptake is 999.0, it resets correctly before accumulating.
      cohort%year_net_uptake(1) = 999.0_r8
      cohort%ts_net_uptake(1) = 0.5_r8
      
      cohort%taller => null()
      patch%shortest => cohort
      patch%younger => null()
      sites(1)%oldest_patch => patch
      
      allocate(bc_in(1)%filter_photo_pa(1))
      bc_in(1)%filter_photo_pa(1) = 3
      dt_time = 3600.2_r8

      call AccumulateFluxes_ED(nsites, sites, bc_in, bc_out, dt_time)

      ! year_net_uptake(1) should have reset to 0, then added 0.5
      @assertEqual(0.5_r8, cohort%year_net_uptake(1), tolerance=1.e-8_r8)
      deallocate(cohort)
      deallocate(patch)
      deallocate(bc_in(1)%filter_photo_pa)
    end subroutine test_AccumulateFluxes_ED_YearNetUptake999

    @Test
    subroutine test_AccumulateFluxes_ED_SkipConditions(this)
      class(TestEDAccumulateFluxes), intent(inout) :: this
      integer, parameter :: nsites = 1
      type(ed_site_type), target :: sites(nsites)
      type(bc_in_type) :: bc_in(nsites)
      type(bc_out_type) :: bc_out(nsites)
      type(fates_patch_type), pointer :: patch_bare, patch_skip
      type(fates_cohort_type), pointer :: cohort_bare, cohort_skip
      real(r8) :: dt_time

      allocate(patch_bare)
      allocate(cohort_bare)
      allocate(patch_skip)
      allocate(cohort_skip)

      ! Patch 1: Bare ground
      patch_bare%patchno = 1
      patch_bare%nocomp_pft_label = nocomp_bareground

      cohort_bare%gpp_acc = 1.0_r8
      cohort_bare%gpp_tstep = 0.5_r8
      cohort_bare%resp_m_acc = 0.2_r8
      cohort_bare%resp_m_tstep = 0.1_r8
      cohort_bare%sym_nfix_daily = 0.2_r8
      cohort_bare%sym_nfix_tstep = 0.2_r8
      cohort_bare%c13disc_acc = 0.1_r8
      cohort_bare%c13disc_clm = 0.2_r8
      cohort_bare%nv = 1
      cohort_bare%year_net_uptake(1) = 0.2_r8
      cohort_bare%ts_net_uptake(1) = 0.5_r8
      
      cohort_bare%taller => null()
      patch_bare%shortest => cohort_bare

      ! Patch 2: filter_photo_pa != 3
      patch_skip%patchno = 2
      patch_skip%nocomp_pft_label = 1

      cohort_skip%gpp_acc = 1.0_r8
      cohort_skip%gpp_tstep = 0.5_r8
      cohort_skip%resp_m_acc = 0.2_r8
      cohort_skip%resp_m_tstep = 0.1_r8
      cohort_skip%sym_nfix_daily = 0.2_r8
      cohort_skip%sym_nfix_tstep = 0.2_r8
      cohort_skip%c13disc_acc = 0.1_r8
      cohort_skip%c13disc_clm = 0.2_r8
      cohort_skip%nv = 1
      cohort_skip%year_net_uptake(1) = 0.2_r8
      cohort_skip%ts_net_uptake(1) = 0.5_r8
      
      cohort_skip%taller => null()
      patch_skip%shortest => cohort_skip

      patch_bare%younger => patch_skip
      patch_skip%younger => null()
      sites(1)%oldest_patch => patch_bare
      
      allocate(bc_in(1)%filter_photo_pa(2))
      bc_in(1)%filter_photo_pa(1) = 3 ! doesn't matter, bare ground
      ! Patch 2: Setting filter_photo_pa to something other than 3 (e.g. 1)
      ! flags that it's inactive, so flux accumulation should be skipped.
      bc_in(1)%filter_photo_pa(2) = 1 ! not 3
      dt_time = 3600.2_r8

      call AccumulateFluxes_ED(nsites, sites, bc_in, bc_out, dt_time)

      ! Should not accumulate for bare ground
      @assertEqual(1.0_r8, cohort_bare%gpp_acc, tolerance=1.e-8_r8)
      
      ! Should not accumulate for filter_photo_pa != 3
      @assertEqual(1.0_r8, cohort_skip%gpp_acc, tolerance=1.e-8_r8)
      deallocate(cohort_skip)
      deallocate(patch_skip)
      deallocate(cohort_bare)
      deallocate(patch_bare)

      deallocate(bc_in(1)%filter_photo_pa)
    end subroutine test_AccumulateFluxes_ED_SkipConditions
end module test_EDAccumulateFluxes
