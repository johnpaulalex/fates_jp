module test_LeafBiophysics
  !
  ! DESCRIPTION:
  !   Unit tests for LeafBiophysicsMod routines in FATES.
  !
  use FatesConstantsMod, only : r8 => fates_r8, tfrz => t_water_freeze_k_1atm
  use LeafBiophysicsMod, only : QSat, &
                                StomatalCondMedlyn, &
                                StomatalCondBallBerry, &
                                LowstorageMainRespReduction, &
                                LeafLayerMaintenanceRespiration_Ryan_1991, &
                                LeafLayerMaintenanceRespiration_Atkin_etal_2017, &
                                GetCanopyGasParameters, &
                                DecayCoeffVcmax, &
                                GetConstrainedVPress, &
                                VeloToMolarCF, &
                                LeafHumidityStomaResis, &
                                rsmax0, &
                                lb_params, &
                                c3_path_index, &
                                c4_path_index
  use funit

  implicit none
  
  @TestCase
  type, extends(TestCase) :: TestLeafBiophysics
    contains
      procedure :: setUp
      procedure :: tearDown 
  end type TestLeafBiophysics
  
  ! 1.e-13_r8: Precision tolerance near the 64-bit float limit used for exact matching.
  real(r8), parameter :: tol = 1.e-13_r8

  contains 
  
    subroutine setUp(this)
      ! lb_params is normally loaded from the FATES NetCDF parameter file at run-time;
      ! here we manually set the minimum fields needed for two synthetic PFTs (C3, C4).
      class(TestLeafBiophysics), intent(inout) :: this

      allocate(lb_params%c3psn(2))
      allocate(lb_params%maintresp_leaf_ryan1991_baserate(2))
      allocate(lb_params%maintresp_leaf_atkin2017_baserate(2))
      allocate(lb_params%maintresp_reduction_curvature(2))
      allocate(lb_params%maintresp_reduction_intercept(2))

      ! Pathway flags; module-level constants from LeafBiophysicsMod.
      lb_params%c3psn(1) = c3_path_index
      lb_params%c3psn(2) = c4_path_index

      ! FATES default (fates_params_default.cdl): 2.525e-06 gC gN-1 s-1 for all PFTs.
      lb_params%maintresp_leaf_ryan1991_baserate(1) = 2.525e-6_r8
      lb_params%maintresp_leaf_ryan1991_baserate(2) = 2.525e-6_r8

      ! FATES default r0 for PFT 1 (tropical broadleaf evergreen): 1.756 umol CO2 m-2 s-1.
      lb_params%maintresp_leaf_atkin2017_baserate(1) = 1.756_r8
      lb_params%maintresp_leaf_atkin2017_baserate(2) = 1.756_r8

      ! Non-default values chosen to exercise two branches of LowstorageMainRespReduction:
      !   1.0 -> linear branch (FATES default is 0.01; 1=linear, 0=maximally curved)
      !   0.5 -> curved power-law branch
      lb_params%maintresp_reduction_curvature(1) = 1.0_r8
      lb_params%maintresp_reduction_curvature(2) = 0.5_r8

      ! Non-default (FATES default=1.0); 0.8 gives non-trivial hand-calculable values.
      lb_params%maintresp_reduction_intercept(1) = 0.8_r8
      lb_params%maintresp_reduction_intercept(2) = 0.8_r8
    end subroutine setUp

    subroutine tearDown(this)
      class(TestLeafBiophysics), intent(inout) :: this
      deallocate(lb_params%c3psn)
      deallocate(lb_params%maintresp_leaf_ryan1991_baserate)
      deallocate(lb_params%maintresp_leaf_atkin2017_baserate)
      deallocate(lb_params%maintresp_reduction_curvature)
      deallocate(lb_params%maintresp_reduction_intercept)
    end subroutine tearDown

    @Test
    subroutine test_QSat(this)
      ! Test saturation vapor pressure and specific humidity across range of temperatures.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: T, p, qs, es, qsdT, esdT
      
      ! Test at 25C (298.15 K) and standard pressure (101325 Pa)
      T = 298.15_r8
      p = 101325.0_r8
      call QSat(T, p, qs, es, qsdT, esdT)
      
      ! Check qs and es are positive and within physically realistic bounds
      ! 0.0_r8: Physical boundary condition where pressure and humidity must be positive
      @assertTrue(qs > 0.0_r8)
      @assertTrue(es > 0.0_r8)
      @assertTrue(qsdT > 0.0_r8)
      @assertTrue(esdT > 0.0_r8)
      
      ! Target values and tolerances determined by running QSat at 25C and standard pressure.
      @assertEqual(3169.2169_r8, es, tolerance=1.e-3_r8)
      @assertEqual(0.019687_r8, qs, tolerance=1.e-5_r8)
      
      ! Test for ice range: -10C (263.15 K)
      T = 263.15_r8
      call QSat(T, p, qs, es, qsdT, esdT)
      @assertTrue(qs > 0.0_r8)
      @assertTrue(es > 0.0_r8)
      @assertTrue(qsdT > 0.0_r8)
      @assertTrue(esdT > 0.0_r8)
    end subroutine test_QSat

    @Test
    subroutine test_StomatalCondMedlyn(this)
      ! Test Medlyn stomatal conductance under varying assimilation rates, slopes, and water stresses.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: anet, veg_esat, can_vpress, gs0, gs1, gs2, leaf_co2_ppress, can_press, gb, gs
      
      ! Standard physiological inputs representing typical C3 conditions for Medlyn model.
      veg_esat = 3167.0_r8
      can_vpress = 1500.0_r8
      gs0 = 10000.0_r8
      gs1 = 5.0_r8
      gs2 = 1.0_r8
      leaf_co2_ppress = 30.0_r8
      can_press = 101325.0_r8
      gb = 2000000.0_r8
      
      ! Branch 1: anet <= anet_min (trivial solution, gs = gs0)
      ! 0.0_r8: Zero assimilation should trigger minimum stomatal conductance.
      anet = 0.0_r8
      call StomatalCondMedlyn(anet, veg_esat, can_vpress, gs0, gs1, gs2, leaf_co2_ppress, can_press, gb, gs)
      @assertEqual(gs0, gs, tolerance=tol)
      
      ! Branch 2: gs2 < 0.01_r8 (trivial case, gs = gs0)
      ! 10.0_r8: Positive assimilation; 0.0_r8: zero water stress factor triggers minimum conductance.
      anet = 10.0_r8
      call StomatalCondMedlyn(anet, veg_esat, can_vpress, gs0, gs1, 0.0_r8, leaf_co2_ppress, can_press, gb, gs)
      @assertEqual(gs0, gs, tolerance=tol)
      
      ! Branch 3: gs1 < 0.01_r8 (trivial case, gs = gs0 + 1.6 * anet / (leaf_co2_ppress/can_press))
      ! 0.0_r8: Zero slope factor triggers simplified conductance calculation.
      call StomatalCondMedlyn(anet, veg_esat, can_vpress, gs0, 0.0_r8, gs2, leaf_co2_ppress, can_press, gb, gs)
      ! 1.6_r8: Ratio of diffusivity of water vapor to CO2.
      @assertEqual(gs0 + 1.6_r8 * anet / (leaf_co2_ppress / can_press), gs, tolerance=tol)
      
      ! General non-trivial case
      call StomatalCondMedlyn(anet, veg_esat, can_vpress, gs0, gs1, gs2, leaf_co2_ppress, can_press, gb, gs)
      @assertTrue(gs > gs0)
    end subroutine test_StomatalCondMedlyn

    @Test
    subroutine test_StomatalCondBallBerry(this)
      ! Test Ball-Berry stomatal conductance under varying index, slope, and standard environments.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: a_gs, a_net, veg_esat, can_vpress, gs0, gs1, leaf_co2_ppress, can_press, gb, gs
      
      ! Standard physiological inputs representing typical C3 conditions for Ball-Berry model.
      veg_esat = 3167.0_r8
      can_vpress = 1500.0_r8
      gs0 = 10000.0_r8
      gs1 = 9.0_r8
      leaf_co2_ppress = 30.0_r8
      can_press = 101325.0_r8
      gb = 2000000.0_r8
      
      ! Branch 1: a_gs <= nearzero (gs = gs0)
      ! 0.0_r8: Zero stomatal index triggers minimum conductance; 10.0_r8: positive assimilation.
      a_gs = 0.0_r8
      a_net = 10.0_r8
      call StomatalCondBallBerry(a_gs, a_net, veg_esat, can_vpress, gs0, gs1, leaf_co2_ppress, can_press, gb, gs)
      @assertEqual(gs0, gs, tolerance=tol)
      
      ! Branch 2: gs1 < 0.01_r8 (gs = gs0)
      ! 10.0_r8: Positive stomatal index; 0.0_r8: zero slope factor triggers minimum conductance.
      a_gs = 10.0_r8
      call StomatalCondBallBerry(a_gs, a_net, veg_esat, can_vpress, gs0, 0.0_r8, leaf_co2_ppress, can_press, gb, gs)
      @assertEqual(gs0, gs, tolerance=tol)
      
      ! General case
      call StomatalCondBallBerry(a_gs, a_net, veg_esat, can_vpress, gs0, gs1, leaf_co2_ppress, can_press, gb, gs)
      @assertTrue(gs > gs0)
    end subroutine test_StomatalCondBallBerry

    @Test
    subroutine test_LowstorageMainRespReduction(this)
      ! Test low-storage maintenance respiration scaling factor for linear and curved response cases.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: frac, factor
      integer :: ft
      
      ! 1: Index of PFT configured with linear respiration reduction.
      ft = 1
      
      ! frac >= 1.0 -> no reduction (factor = 1.0)
      ! 1.2_r8: Storage fraction above threshold; 1.0_r8: expected scaling factor (no reduction).
      frac = 1.2_r8
      call LowstorageMainRespReduction(frac, ft, factor)
      @assertEqual(1.0_r8, factor, tolerance=tol)
      
      ! frac < 1.0 -> linear reduction: (1 - intercept) + intercept * frac = 0.2 + 0.8 * 0.5 = 0.6
      ! 0.5_r8: Half of storage remains; 0.6_r8: expected linear scaling factor under 0.8 intercept.
      frac = 0.5_r8
      call LowstorageMainRespReduction(frac, ft, factor)
      @assertEqual(0.6_r8, factor, tolerance=tol)
      
      ! ft = 2 (curved case: curvature = 0.5, intercept = 0.8)
      ! 2: Curved PFT index; 0.5_r8: storage fraction; 0.6686291501_r8: expected curved factor; 1.e-7_r8: precision tolerance.
      ft = 2
      frac = 0.5_r8
      ! factor = (1 - 0.8) + 0.8 * (1 - 0.5**0.5) / (1 - 0.5)
      !        = 0.2 + 1.6 * 0.29289322 = 0.2 + 0.46862915 = 0.66862915
      call LowstorageMainRespReduction(frac, ft, factor)
      @assertEqual(0.6686291501_r8, factor, tolerance=1.e-7_r8)
    end subroutine test_LowstorageMainRespReduction

    @Test
    subroutine test_LeafLayerMaintenanceRespiration_Ryan_1991(this)
      ! Test Ryan (1991) leaf layer maintenance respiration for C3 and C4 plants at standard temperature.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: lnc_top, nscaler, veg_tempk, lmr
      integer :: ft
      
      ! 1.5_r8: Leaf nitrogen content (gN/m2); 0.8_r8: canopy depth nitrogen scaling factor.
      lnc_top = 1.5_r8
      nscaler = 0.8_r8
      
      ! PFT 1: C3 plant at 25C (298.15 K)
      ! 1: C3 PFT index; 25.0_r8: standard reference temperature offset in Celsius.
      ft = 1
      veg_tempk = tfrz + 25.0_r8
      call LeafLayerMaintenanceRespiration_Ryan_1991(lnc_top, nscaler, ft, veg_tempk, lmr)
      @assertTrue(lmr > 0.0_r8)
      
      ! PFT 2: C4 plant at 25C (298.15 K)
      ! 2: C4 PFT index.
      ft = 2
      veg_tempk = tfrz + 25.0_r8
      call LeafLayerMaintenanceRespiration_Ryan_1991(lnc_top, nscaler, ft, veg_tempk, lmr)
      @assertTrue(lmr > 0.0_r8)
    end subroutine test_LeafLayerMaintenanceRespiration_Ryan_1991

    @Test
    subroutine test_LeafLayerMaintenanceRespiration_Atkin_etal_2017(this)
      ! Test Atkin et al. (2017) leaf layer maintenance respiration under typical and high-temperature conditions.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: lnc_top, rdark_scaler, veg_tempk, tgrowth, lmr
      integer :: ft
      
      ! Input variables: 1.5_r8 (N content), 2.43_r8 (dark scaler), 1 (C3), 20.0_r8 (growth temp C), 25.0_r8 (leaf temp C).
      lnc_top = 1.5_r8
      rdark_scaler = 2.43_r8
      ft = 1
      tgrowth = tfrz + 20.0_r8
      veg_tempk = tfrz + 25.0_r8
      
      ! Hand-calculated:
      ! r_t_ref = 2.43 * (1.756 + 0.2061 * 1.5 - 0.0402 * 20.0) = 3.0645945
      ! At veg_tempk = tfrz + 25.0, lmr should be exactly r_t_ref = 3.0645945
      call LeafLayerMaintenanceRespiration_Atkin_etal_2017(lnc_top, rdark_scaler, ft, veg_tempk, tgrowth, lmr)
      ! 3.0645945_r8: Hand-calculated respiration rate (umol/m2/s); 1.e-6_r8: precision tolerance.
      @assertEqual(3.0645945_r8, lmr, tolerance=1.e-6_r8)
      
      ! Test capped r_t_ref = 0 when tgrowth is extremely large
      ! 100.0_r8: Extreme growth temperature offset to trigger zero respiration; 0.0_r8: expected output.
      tgrowth = tfrz + 100.0_r8
      call LeafLayerMaintenanceRespiration_Atkin_etal_2017(lnc_top, rdark_scaler, ft, veg_tempk, tgrowth, lmr)
      @assertEqual(0.0_r8, lmr, tolerance=tol)
    end subroutine test_LeafLayerMaintenanceRespiration_Atkin_etal_2017

    @Test
    subroutine test_GetCanopyGasParameters(this)
      ! Test canopy gas parameters (Michaelis-Menten constants and CO2 photocompensation) at standard and extreme temperatures.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: can_press, can_o2_partialpress, veg_tempk, mm_kco2, mm_ko2, co2_cpoint
      
      ! 100000.0_r8: Rounded reference atmospheric pressure (Pa); 20900.0_r8: standard O2 partial pressure (Pa).
      can_press = 100000.0_r8
      can_o2_partialpress = 20900.0_r8
      
      ! Test at 25C (298.15 K)
      ! 25.0_r8: Standard reference temperature offset in Celsius.
      veg_tempk = tfrz + 25.0_r8
      call GetCanopyGasParameters(can_press, can_o2_partialpress, veg_tempk, mm_kco2, mm_ko2, co2_cpoint)
      
      ! kc25 = ( 404.9 / 1.e6 ) * 100000 = 40.49
      ! ko25 = ( 278.4 / 1.e3 ) * 100000 = 27840
      ! cp25 = 4.275
      ! expected results: 40.49_r8 (kc), 27840.0_r8 (ko), 4.275_r8 (cp) at 25C; 1.e-6_r8: tolerance.
      @assertEqual(40.49_r8, mm_kco2, tolerance=1.e-6_r8)
      @assertEqual(27840.0_r8, mm_ko2, tolerance=1.e-6_r8)
      @assertEqual(4.275_r8, co2_cpoint, tolerance=1.e-6_r8)
      
      ! Test at extreme/out of range temperature (veg_tempk = 100.0) -> returns 1.0
      ! 100.0_r8: Out-of-bounds low temperature (K) to test fallback; 1.0_r8: default fallback value.
      veg_tempk = 100.0_r8
      call GetCanopyGasParameters(can_press, can_o2_partialpress, veg_tempk, mm_kco2, mm_ko2, co2_cpoint)
      @assertEqual(1.0_r8, mm_kco2, tolerance=tol)
      @assertEqual(1.0_r8, mm_ko2, tolerance=tol)
      @assertEqual(1.0_r8, co2_cpoint, tolerance=tol)
    end subroutine test_GetCanopyGasParameters

    @Test
    subroutine test_DecayCoeffVcmax(this)
      ! Verify exponential decay coefficient calculation for leaf Vcmax with height/LAI.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: decay

      ! 50.0 (cai), 0.009 (decay), 0.12 (offset) represent typical mid-canopy C3 values and default parameters.
      decay = DecayCoeffVcmax(50.0_r8, 0.009_r8, 0.12_r8)
      @assertEqual(1.39096812838_r8, decay, tolerance=1.e-7_r8)

      ! Inputs chosen to yield an exact zero exponent (0.1 * 10.0 - 1.0 = 0.0) to test base scaling.
      decay = DecayCoeffVcmax(10.0_r8, 0.1_r8, 1.0_r8)
      @assertEqual(1.0_r8, decay, tolerance=tol)
    end subroutine test_DecayCoeffVcmax

    @Test
    subroutine test_GetConstrainedVPress(this)
      ! Verify vapor pressure constraints are correctly applied within the 5% minimum and 100% maximum bounds.
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: ceair

      ! Saturation vapor pressure 3000.0 Pa represents a leaf at standard warm conditions (~24 C).
      ! Vapor pressure 1000.0 Pa lies inside the allowed bounds of [150.0, 3000.0] Pa.
      ceair = GetConstrainedVPress(1000.0_r8, 3000.0_r8)
      @assertEqual(1000.0_r8, ceair, tolerance=tol)

      ! Vapor pressure 100.0 Pa is below the 5% minimum limit of 150.0 Pa to trigger capping.
      ceair = GetConstrainedVPress(100.0_r8, 3000.0_r8)
      @assertEqual(150.0_r8, ceair, tolerance=tol)

      ! Vapor pressure 3500.0 Pa is above the 100% saturation limit of 3000.0 Pa to trigger capping.
      ceair = GetConstrainedVPress(3500.0_r8, 3000.0_r8)
      @assertEqual(3000.0_r8, ceair, tolerance=tol)
    end subroutine test_GetConstrainedVPress

    @Test
    subroutine test_VeloToMolarCF(this)
      ! Verify conversion factor between boundary layer velocity (m/s) and molar flux (umol/m2/s/Pa).
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: cf

      ! Standard sea-level pressure (101325.0 Pa) and 25 C (298.15 K) to test default conversion.
      cf = VeloToMolarCF(101325.0_r8, 298.15_r8)
      @assertEqual(40874058.377671719_r8, cf, tolerance=1.e-4_r8)

      ! Reference pressure (100000.0 Pa) and 0 C freezing boundary (273.15 K) to test thermal range.
      cf = VeloToMolarCF(100000.0_r8, 273.15_r8)
      @assertEqual(44031629.437512256_r8, cf, tolerance=1.e-4_r8)
    end subroutine test_VeloToMolarCF

    @Test
    subroutine test_LeafHumidityStomaResis(this)
      class(TestLeafBiophysics), intent(inout) :: this
      real(r8) :: leaf_psi, k_lwp, veg_tempk, can_vpress, can_press, rb, gstoma, veg_esat, rstoma_out
      integer :: ft
      real(r8) :: expected_rstoma

      ! Base parameters
      can_press = 101325.0_r8
      rb = 50.0_r8
      gstoma = 0.5_r8
      ft = 1

      ! ---------------------------------------------------------
      ! Case 1: Branch 1 (qsat_adj < qs) triggers rsmax0 fallback
      ! ---------------------------------------------------------
      leaf_psi = -2.0_r8
      k_lwp = 100.0_r8
      veg_tempk = 298.15_r8
      can_vpress = 1800.0_r8
      veg_esat = 2000.0_r8
      rstoma_out = LeafHumidityStomaResis(leaf_psi, k_lwp, veg_tempk, can_vpress, can_press, rb, gstoma, ft, veg_esat)
      @assertEqual(rsmax0, rstoma_out, tolerance=tol)

      ! ---------------------------------------------------------
      ! Case 2: lwp_star = 1.0 (leaf_psi = 0.0) -> rstoma_out = 1/gstoma
      ! ---------------------------------------------------------
      leaf_psi = 0.0_r8
      k_lwp = 1.0_r8
      veg_tempk = 298.15_r8
      can_vpress = 1000.0_r8
      veg_esat = 2000.0_r8
      rstoma_out = LeafHumidityStomaResis(leaf_psi, k_lwp, veg_tempk, can_vpress, can_press, rb, gstoma, ft, veg_esat)
      ! If lwp_star = 1.0, qsat_adj == qsat_loc.
      ! The formula reduces exactly to 1.0 / gstoma + rb - rb = 1.0 / gstoma
      expected_rstoma = 1.0_r8 / gstoma
      @assertEqual(expected_rstoma, rstoma_out, tolerance=tol)

      ! ---------------------------------------------------------
      ! Case 3: General case (lwp_star < 1.0 but qsat_adj > qs)
      ! ---------------------------------------------------------
      leaf_psi = -1.0_r8
      k_lwp = 1.0_r8
      veg_tempk = 298.15_r8
      can_vpress = 1000.0_r8
      veg_esat = 2000.0_r8
      rstoma_out = LeafHumidityStomaResis(leaf_psi, k_lwp, veg_tempk, can_vpress, can_press, rb, gstoma, ft, veg_esat)
      ! Expected value calculated externally (2.760584_r8)
      expected_rstoma = 2.760584_r8
      @assertEqual(expected_rstoma, rstoma_out, tolerance=1.e-5_r8)

    end subroutine test_LeafHumidityStomaResis

end module test_LeafBiophysics